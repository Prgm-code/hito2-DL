---
import "../styles/booking-dynamic.css";
---

<aside class="booking-card sticky top-5 rounded-[var(--radius)] border border-[var(--line)] bg-white/90 p-[26px] shadow-[var(--shadow)] backdrop-blur-xl max-[820px]:static max-[650px]:rounded-2xl max-[650px]:p-[19px]" id="reserva">
  <div class="booking-heading mb-6 flex items-center gap-[13px]">
    <div class="grid size-[42px] place-items-center rounded-[13px] bg-[var(--mint)] text-[#345c0d]" aria-hidden="true">
      <svg class="w-5 fill-none stroke-current stroke-[1.7]" viewBox="0 0 24 24"><path d="M5 19 19 5M9 5h10v10M5 8v11h11"/></svg>
    </div>
    <div><span class="mb-0.5 block text-[9px] font-extrabold uppercase tracking-[.14em] text-[#829087]">Paso 1 de 1</span><h2 class="m-0 text-[22px] tracking-[-.035em]">Diseña tu viaje</h2></div>
  </div>

  <form id="booking-form" aria-describedby="booking-api-status" novalidate>
    <div id="booking-api-status" class="mb-3" aria-live="assertive" hidden></div>
    <div class="field-row grid grid-cols-2 gap-3 max-[460px]:grid-cols-1 max-[460px]:gap-0">
      <label class="mb-[15px] block"><span class="mb-[7px] ml-0.5 flex justify-between text-[10px] font-extrabold tracking-[.03em]">Nombre del pasajero</span><input class="h-[43px] w-full rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] px-3 text-[11px] text-[var(--ink)] outline-none transition placeholder:text-[#a6afa9] focus:border-[#82b834] focus:shadow-[0_0_0_3px_rgba(169,245,44,.16)]" id="passengerName" name="passengerName" type="text" autocomplete="name" placeholder="Ej: Morty Smith" required /></label>
      <label class="mb-[15px] block"><span class="mb-[7px] ml-0.5 flex justify-between text-[10px] font-extrabold tracking-[.03em]">Correo electrónico</span><input class="h-[43px] w-full rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] px-3 text-[11px] text-[var(--ink)] outline-none transition placeholder:text-[#a6afa9] focus:border-[#82b834] focus:shadow-[0_0_0_3px_rgba(169,245,44,.16)]" id="email" name="email" type="email" autocomplete="email" placeholder="morty@email.com" required /></label>
    </div>

    <div class="field-row relative grid grid-cols-2 gap-3 max-[460px]:grid-cols-1 max-[460px]:gap-0">
      <label class="mb-[15px] block"><span class="mb-[7px] ml-0.5 flex justify-between text-[10px] font-extrabold tracking-[.03em]">Origen</span><select class="h-[43px] w-full rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] px-3 pr-[30px] text-[11px] text-[var(--ink)] outline-none transition focus:border-[#82b834] focus:shadow-[0_0_0_3px_rgba(169,245,44,.16)] disabled:cursor-not-allowed disabled:bg-[#eef1ed] disabled:text-[#9aa49d]" id="originId" name="originId" required><option value="">Selecciona un origen</option></select></label>
      <span class="absolute bottom-[25px] left-[calc(50%_-_13px)] z-[2] grid size-[26px] place-items-center rounded-full border border-[var(--line)] bg-white text-xs max-[460px]:hidden" aria-hidden="true">→</span>
      <label class="mb-[15px] block"><span class="mb-[7px] ml-0.5 flex justify-between text-[10px] font-extrabold tracking-[.03em]">Destino</span><select class="h-[43px] w-full rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] px-3 pr-[30px] text-[11px] text-[var(--ink)] outline-none transition focus:border-[#82b834] focus:shadow-[0_0_0_3px_rgba(169,245,44,.16)] disabled:cursor-not-allowed disabled:bg-[#eef1ed] disabled:text-[#9aa49d]" id="destinationId" name="destinationId" required><option value="">Selecciona un destino</option></select></label>
    </div>

    <div id="destination-hint" class="-mt-1 mb-[15px] flex justify-between rounded-lg bg-[#f2f8e9] px-2.5 py-2 text-[9px] text-[#607052]" hidden></div>

    <div class="field-row grid grid-cols-2 gap-3 max-[460px]:grid-cols-1 max-[460px]:gap-0">
      <label class="mb-[15px] block"><span class="mb-[7px] ml-0.5 flex justify-between text-[10px] font-extrabold tracking-[.03em]">Fecha del viaje</span><input class="h-[43px] w-full rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] px-3 text-[11px] text-[var(--ink)] outline-none transition focus:border-[#82b834] focus:shadow-[0_0_0_3px_rgba(169,245,44,.16)]" id="travelDate" name="travelDate" type="date" required /></label>
      <label class="mb-[15px] block"><span class="mb-[7px] ml-0.5 flex justify-between text-[10px] font-extrabold tracking-[.03em]">Pasajeros</span><span class="grid h-[43px] grid-cols-[34px_1fr_34px] overflow-hidden rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9]"><button class="cursor-pointer border-0 bg-transparent text-[17px] hover:bg-[#edf5e2]" type="button" data-step="-1" aria-label="Restar pasajero">−</button><input class="h-[41px] w-full appearance-none rounded-none border-0 bg-[#fbfcf9] p-0 text-center text-[11px] outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" id="passengers" name="passengers" type="number" min="1" max="8" value="1" readonly /><button class="cursor-pointer border-0 bg-transparent text-[17px] hover:bg-[#edf5e2]" type="button" data-step="1" aria-label="Sumar pasajero">+</button></span></label>
    </div>

    <fieldset class="m-[0_0_15px] border-0 p-0">
      <legend class="mb-2 flex w-full justify-between text-[10px] font-extrabold">
        <span class="flex gap-1.5">Elige tu equipo <small class="font-medium text-[#94a098]">Solo personajes vivos</small></span>
        <b class="text-[9px] text-[#587d20]" id="companion-status">0 / 3</b>
      </legend>
      <div id="companion-grid" class="companion-grid grid max-h-[188px] grid-cols-2 gap-[7px] overflow-y-auto p-0.5 [scrollbar-color:#b4c3b5_transparent] max-[460px]:grid-cols-1" aria-live="polite">
        <p class="col-span-full m-0 rounded-[10px] border border-dashed border-[var(--line)] p-[18px] text-center text-[9px] text-[#89948c]">Selecciona un destino para descubrir acompañantes.</p>
      </div>
    </fieldset>

    <fieldset class="mb-[15px] grid grid-cols-3 gap-2 border-0 p-0 max-[460px]:grid-cols-1">
      <legend class="col-span-full mb-[7px] ml-0.5 flex w-full justify-between text-[10px] font-extrabold tracking-[.03em]">Tipo de viaje</legend>
      <label class="relative cursor-pointer"><input class="peer pointer-events-none absolute opacity-0" type="radio" name="tripType" value="express" checked /><span class="flex flex-col rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] px-[9px] py-2.5 peer-checked:border-[#75a82b] peer-checked:bg-[#f0fbdc] peer-checked:shadow-[inset_0_0_0_1px_#75a82b] peer-focus-visible:outline-3 peer-focus-visible:outline-[rgba(117,168,43,.22)] max-[460px]:flex-row max-[460px]:items-center max-[460px]:justify-between"><b class="text-[10px]">Express</b><small class="mt-0.5 text-[8px] text-[#88948c]">Ida directa</small></span></label>
      <label class="relative cursor-pointer"><input class="peer pointer-events-none absolute opacity-0" type="radio" name="tripType" value="exploration" /><span class="flex flex-col rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] px-[9px] py-2.5 peer-checked:border-[#75a82b] peer-checked:bg-[#f0fbdc] peer-checked:shadow-[inset_0_0_0_1px_#75a82b] peer-focus-visible:outline-3 peer-focus-visible:outline-[rgba(117,168,43,.22)] max-[460px]:flex-row max-[460px]:items-center max-[460px]:justify-between"><b class="text-[10px]">Exploración</b><small class="mt-0.5 text-[8px] text-[#88948c]">+30% · flexible</small></span></label>
      <label class="relative cursor-pointer"><input class="peer pointer-events-none absolute opacity-0" type="radio" name="tripType" value="premium" /><span class="flex flex-col rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] px-[9px] py-2.5 peer-checked:border-[#75a82b] peer-checked:bg-[#f0fbdc] peer-checked:shadow-[inset_0_0_0_1px_#75a82b] peer-focus-visible:outline-3 peer-focus-visible:outline-[rgba(117,168,43,.22)] max-[460px]:flex-row max-[460px]:items-center max-[460px]:justify-between"><b class="text-[10px]">Premium</b><small class="mt-0.5 text-[8px] text-[#88948c]">+65% · VIP</small></span></label>
    </fieldset>

    <label class="mb-[15px] grid cursor-pointer grid-cols-[auto_1fr_auto] items-center gap-2.5 rounded-[11px] border border-[#dce4dc] bg-[#fbfcf9] p-3">
      <span class="relative h-[19px] w-8"><input class="peer absolute size-px opacity-0" id="insurance" name="insurance" type="checkbox" /><i class="block h-[19px] w-8 rounded-[20px] bg-[#cbd3cc] transition after:absolute after:left-[3px] after:top-[3px] after:size-[13px] after:rounded-full after:bg-white after:shadow-[0_1px_3px_rgba(0,0,0,.2)] after:transition after:content-[''] peer-checked:bg-[#73a721] peer-checked:after:translate-x-[13px]"></i></span>
      <span class="flex flex-col"><b class="text-[10px]">Seguro interdimensional</b><small class="mt-0.5 text-[8px] text-[#88948c]" id="insurance-copy">Cobertura ante portales inestables</small></span>
      <strong class="text-[9px] text-[#5d7c30]">+ $190 p/p</strong>
    </label>

    <label class="mb-3 block"><span class="mb-[7px] ml-0.5 flex justify-between text-[10px] font-extrabold tracking-[.03em]">Comentarios <small class="font-medium text-[#94a098]">Opcional</small></span><textarea class="min-h-16 w-full resize-y rounded-[10px] border border-[#dce4dc] bg-[#fbfcf9] p-3 text-[11px] leading-normal text-[var(--ink)] outline-none transition placeholder:text-[#a6afa9] focus:border-[#82b834] focus:shadow-[0_0_0_3px_rgba(169,245,44,.16)]" id="comments" name="comments" rows="2" maxlength="240" placeholder="¿Alguna petición especial?"></textarea></label>

    <div id="form-errors" class="form-errors mb-3 rounded-[9px] border border-[#f1bbb1] bg-[#fff3f0] px-3 py-2.5 text-[9px] text-[#933725]" role="alert" hidden></div>

    <div class="mb-[11px] grid grid-cols-2 gap-2">
      <div class="flex items-center justify-between rounded-[10px] bg-[#f1f3ee] p-[11px]"><span class="text-[8px] uppercase tracking-[.05em] text-[#78847c]">Riesgo estimado</span><strong id="risk-value" class="inline-flex items-center gap-[5px] text-[9px] font-extrabold uppercase text-[#b84936] [&>i]:bg-[var(--red)] [&>i]:shadow-[0_0_0_3px_rgba(240,109,86,.13)]"><i class="size-1.5 rounded-full"></i> Alto</strong></div>
      <div class="flex items-center justify-between rounded-[10px] bg-[#f1f3ee] p-[11px]"><span class="text-[8px] uppercase tracking-[.05em] text-[#78847c]">Precio estimado</span><strong class="text-sm" id="price-value">US$ 1.200</strong></div>
    </div>

    <button class="flex h-12 w-full cursor-pointer items-center justify-between rounded-[11px] border-0 bg-[var(--ink)] px-[19px] text-[11px] font-extrabold text-white shadow-[0_7px_18px_rgba(16,32,25,.18)] transition hover:-translate-y-px hover:bg-[#1e392c] disabled:cursor-not-allowed disabled:bg-[#879188] disabled:shadow-none disabled:hover:translate-y-0" id="confirm-booking" type="submit"><span>Confirmar reserva</span><span aria-hidden="true">→</span></button>
    <p class="mt-2.5 -mb-1 flex items-center justify-center gap-1.5 text-[8px] text-[#909990]"><svg class="w-3 fill-none stroke-current stroke-[1.8]" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg> Tus datos se guardan únicamente en este dispositivo</p>
  </form>
</aside>
