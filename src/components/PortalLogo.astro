---
import { IconUniverse } from '@tabler/icons-astro';

interface Props {
  href?: string;
  theme?: 'light' | 'dark';
  class?: string;
}

const { href = '/', theme = 'light', class: className = '' } = Astro.props;
const dark = theme === 'dark';
---

<a
  class:list={[
    'inline-flex w-max items-center gap-2.5 text-[17px] font-black tracking-[-.055em] max-[460px]:text-sm',
    dark ? 'text-white' : 'text-[var(--ink)]',
    className,
  ]}
  href={href}
  aria-label="Portal Trip, volver al inicio"
>
  <span
    class:list={[
      'relative grid size-10 place-items-center overflow-hidden rounded-[13px] border shadow-[0_7px_18px_rgba(7,17,13,.14)]',
      dark ? 'border-white/15 bg-white/[.06]' : 'border-[#183326] bg-[var(--ink)]',
    ]}
    aria-hidden="true"
  >
    <span
      class="absolute -right-2 -top-2 size-5 rounded-full bg-[var(--green)]/20 blur-[2px]"
    ></span>
    <IconUniverse size={25} stroke={1.65} color="var(--green)" />
    <span
      class="absolute right-[7px] top-[7px] size-1.5 rounded-full bg-[var(--orange)] shadow-[0_0_0_2px_rgba(255,172,66,.18)]"
    ></span>
  </span>
  <span
    >PORTAL<span class={dark ? 'text-[var(--green)]' : 'text-[var(--green-dark)]'}>TRIP</span></span
  >
</a>
