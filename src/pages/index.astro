---
import Layout from "layouts/Layout.astro";
import { Image } from "astro:assets";
import Header from "components/Header.astro";
import PortalLogo from "components/PortalLogo.astro";
import BookingPanel from "components/BookingPanel.astro";
import DestinationCatalog from "components/DestinationCatalog.astro";
import ReservationsPanel from "components/ReservationsPanel.astro";
import "styles/home.css";
---

<Layout>
  <div class="pointer-events-none fixed right-[-260px] top-[220px] -z-[1] size-[520px] rounded-full bg-[radial-gradient(circle,rgba(169,245,44,.13),transparent_68%)] blur-[2px]" aria-hidden="true"></div>
  <div class="pointer-events-none fixed left-[-270px] top-[760px] -z-[1] size-[440px] rounded-full bg-[radial-gradient(circle,rgba(121,216,230,.13),transparent_68%)] blur-[2px]" aria-hidden="true"></div>

  <Header />

  <main class="mx-auto w-[calc(100%_-_80px)] max-w-[1360px] max-[1100px]:w-[calc(100%_-_40px)] max-[650px]:w-[calc(100%_-_24px)]">
    <section class="relative flex min-h-[92px] items-center justify-start gap-6 overflow-hidden px-[3%] py-1.5 max-[1100px]:min-h-[88px] max-[1100px]:px-[2%] max-[820px]:min-h-[78px] max-[820px]:py-4 max-[650px]:min-h-[72px] max-[650px]:px-1 max-[650px]:py-[3px] max-[460px]:min-h-[66px]" aria-label="Portal interdimensional">
      <div class="relative z-[2] min-w-0 flex-initial max-[820px]:w-full">
        <span class="inline-flex items-center gap-2 text-[11.5px] font-[850] uppercase tracking-[.16em] text-[#4f6c5b]"><span class="size-[7px] rounded-full bg-[var(--green)] shadow-[0_0_0_5px_rgba(169,245,44,.16)]"></span> Agencia interdimensional certificada</span>
        <h1 class="my-[12px_8px] max-w-none text-[clamp(31px,3.1vw,48px)] font-[820] leading-none tracking-[-.055em] max-[650px]:max-w-[620px] max-[650px]:text-[35px] max-[460px]:text-[31px]" id="hero-title">
          Comienza tu viaje intergaláctico junto a
        </h1>
        <p class="m-0 max-w-[680px] text-[14px] leading-relaxed text-[var(--muted)] max-[650px]:max-w-[520px] max-[650px]:text-[13px]">
          Explora planetas, estaciones y dimensiones fuera de este mundo. Tú eliges el destino;
          nosotros calculamos el riesgo.
        </p>
      </div>

      <div class="relative grid h-[110px] w-[230px] flex-none place-items-center max-[820px]:absolute max-[820px]:right-[-25px] max-[820px]:top-1/2 max-[820px]:h-[90px] max-[820px]:-translate-y-1/2 max-[820px]:opacity-10 max-[460px]:h-20 max-[460px]:scale-[.85]">
        <Image
          class="h-auto w-[220px] object-contain"
          src="https://desafiolatam.com/logo-real.png"
          alt="Desafío Latam"
          width={345}
          height={142}
        />
      </div>
    </section>

    <section class="workspace grid grid-cols-[minmax(390px,470px)_minmax(0,1fr)] items-start gap-[30px] pb-[90px] max-[1100px]:grid-cols-[390px_minmax(0,1fr)] max-[820px]:grid-cols-1 max-[460px]:gap-4" aria-label="Planificador de viajes">
      <BookingPanel />
      <div class="catalog-column relative min-w-0">
        <div class="view-tabs absolute inset-x-0 top-0 z-[3] flex h-[62px] gap-[25px] border-b border-[var(--line)] px-7 max-[650px]:h-[58px] max-[650px]:px-[19px] max-[460px]:h-[54px] max-[460px]:px-[15px]" role="tablist" aria-label="Secciones">
          <button class="view-tab active relative cursor-pointer border-0 bg-transparent text-[13.5px] font-bold text-[#7a857e] after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:scale-x-0 after:bg-[var(--green-dark)] after:transition-transform after:content-[''] aria-selected:text-[var(--ink)] aria-selected:after:scale-x-100" id="destinations-tab" data-view="destinations" role="tab" aria-selected="true">
            Explorar destinos
          </button>
          <button class="view-tab relative cursor-pointer border-0 bg-transparent text-[13.5px] font-bold text-[#7a857e] after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:scale-x-0 after:bg-[var(--green-dark)] after:transition-transform after:content-[''] aria-selected:text-[var(--ink)] aria-selected:after:scale-x-100" id="reservations-tab" data-view="reservations" role="tab" aria-selected="false">
            Mis reservas <span id="reservation-count" class="ml-1 inline-grid h-[22px] min-w-[22px] place-items-center rounded-full bg-[#e1e7df] text-[10.5px]">0</span>
          </button>
        </div>
        <DestinationCatalog />
        <ReservationsPanel />
      </div>
    </section>
  </main>

  <footer class="mx-auto flex min-h-[100px] w-[calc(100%_-_80px)] max-w-[1360px] items-center justify-between border-t border-[var(--line)] max-[1100px]:w-[calc(100%_-_40px)] max-[650px]:w-[calc(100%_-_28px)] max-[650px]:flex-col max-[650px]:justify-center max-[650px]:gap-[14px] max-[650px]:text-center">
    <PortalLogo class="opacity-80" />
    <p class="text-[11px] text-[#7a867e]">Viajes interdimensionales desde la Tierra C-137 · Datos de Rick and Morty API</p>
  </footer>

  <div id="toast-region" class="fixed bottom-[22px] right-[22px] z-50 grid gap-2 max-[460px]:inset-x-3 max-[460px]:bottom-3" aria-live="polite"></div>
  <script>
    import "scripts/app";
  </script>
</Layout>
